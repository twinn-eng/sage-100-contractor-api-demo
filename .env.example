# Copy to .env. The backend reads it; nothing here is ever sent to the browser.

# Serve fictional sample data instead of calling the API (no key needed).
# MOCK=1

# One entry per company. One API key reaches one Sage company.
# baseUrl: https://demo.twinn.engineering/api/v3 for the demo company,
#          https://dashboard.twinn.engineering/api/v3 for your own.
COMPANIES=[{"id":"demo","label":"Demo company","baseUrl":"https://demo.twinn.engineering/api/v3","apiKey":"opdc_v3_dev_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}]

# Or, instead of COMPANIES, numbered variables:
# COMPANY_1_ID=demo
# COMPANY_1_LABEL=Demo company
# COMPANY_1_BASE_URL=https://demo.twinn.engineering/api/v3
# COMPANY_1_API_KEY=opdc_v3_dev_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ports: the backend, and the Vite dev server that proxies /api to it.
# API_PORT=8787
# WEB_PORT=5173
